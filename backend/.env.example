PORT=3000
DATABASE_URL="postgresql://tastenest:change-me-db@localhost:5432/tastenest?schema=public"
TEST_DATABASE_URL="postgresql://tastenest:change-me-db@localhost:5432/tastenest_test?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:5173

# Used by `npm run db:seed` to create the first administrator
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@tastenest.local
ADMIN_PASSWORD=change-me-admin
# Demo accounts (avtor@tastenest.local, uporabnik@tastenest.local) share this password.
# Leave empty or set SEED_DEMO_DATA=false to skip demo accounts and recipes.
SEED_DEMO_DATA=true
DEMO_PASSWORD=change-me-demo
