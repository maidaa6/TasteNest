# Nastavitve lokalne baze PostgreSQL za docker compose. Kopirajte v .env.
# Uporabnik, geslo in vrata se morajo ujemati z DATABASE_URL in TEST_DATABASE_URL v backend/.env.
POSTGRES_USER=tastenest
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=tastenest

# Vrata na gostitelju; spremenite, če je 5432 že zaseden (npr. lokalni PostgreSQL)
DB_PORT=5432
